{
	"compilerOptions": {
		"allowJs": false,
		"forceConsistentCasingInFileNames": true,
		//"module": This is local to the config
		"moduleResolution": "bundler",
		"noImplicitAny": true,
		//"outDir": Set in src/client/tsconfig.json (compiles to ./cgi, which Rollup bundles into www/dist)
		"preserveConstEnums": true,
		"pretty": true,
		"removeComments": true,
		"sourceMap": true,
		"strict": true,
		"target": "esnext",
	},
	// local tsconfig specifies local paths
	//"include": [
	//	"./**/*"
	//]
}
